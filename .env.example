# Copy to .env.local and fill in only what you need. Nothing is required.
# Anything VITE_-prefixed is shipped to every browser — never put a secret here.

# --- Basemap -------------------------------------------------------------
# Default: OpenFreeMap (no key, no limits). Optional alternatives:
# VITE_MAPTILER_KEY=
# VITE_MAP_STYLE_URL=        # any MapLibre style URL; overrides the above
# VITE_MAP_ATTRIBUTION=      # only for a style that credits nothing itself
# VITE_MAP_RECOLOUR=false    # keep the basemap's own colours
# NEVER point a style at tile.openstreetmap.org — their usage policy forbids it.

# --- Our tiles -----------------------------------------------------------
# Where the tile build's manifest.json lives. Default: /tiles/manifest.json
# (in dev: build into public/tiles with `npm run tiles:build public/tiles …`).
# VITE_TILES_MANIFEST_URL=

# --- Place search --------------------------------------------------------
# VITE_PHOTON_URL=           # self-hosted Photon; default is photon.komoot.io

# --- Feature flags -------------------------------------------------------
# VITE_ADS_ENABLED=false     # Off by default. Turning it on makes the app commercial:
#                            # Open-Meteo's free tier is non-commercial (CLAUDE.md §9).

# Sign in with OpenStreetMap (optional; walkers with an OSM account add and
# remove amenities directly). The OAuth 2 client id from openstreetmap.org →
# My settings → OAuth 2 applications. Public by design (PKCE, no secret).
# VITE_OSM_OAUTH_CLIENT_ID=
# For testing against the OSM dev server (needs its own registration there):
# VITE_OSM_WEBSITE_URL=https://master.apis.dev.openstreetmap.org
# VITE_OSM_API_URL=https://master.apis.dev.openstreetmap.org
