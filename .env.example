# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed variables.

# --- Basemap (optional) --------------------------------------------------
# Nothing is required: the default basemap is OpenFreeMap (no key, no limits).
# Anything VITE_-prefixed is shipped to every browser — never put a secret here.
#
# Optional: MapTiler instead of OpenFreeMap (finite free allowance).
# VITE_MAPTILER_KEY=

# Overrides the style URL entirely, for a different provider (Stadia,
# Protomaps, self-hosted). Set this and the MapTiler key is ignored.
# NEVER point this at tile.openstreetmap.org — their usage policy forbids it.
# VITE_MAP_STYLE_URL=
# VITE_MAP_ATTRIBUTION=© MapTiler

# --- Feature flags ------------------------------------------------------
# Phase 7 ad slot. The space is reserved either way, so enabling shifts nothing.
# VITE_ADS_ENABLED=false

# --- Overpass proxy seam (Phase 2 seam; no proxy is deployed) -----------
# Off by default. See CLAUDE.md §11, Phase 2, "Proxy-ready seam".
# VITE_OVERPASS_PROXY_ENABLED=false
# VITE_OVERPASS_PROXY_URL=
