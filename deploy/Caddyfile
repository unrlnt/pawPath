# PawPath web server. TLS is terminated in front (Coolify's proxy, then
# Cloudflare), so this listens on plain :80.
{
	auto_https off
	admin off
}

:80 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Tiles: shared volume written by the `tiles` container. No `encode` here:
	# the tiles inside a .pmtiles are already compressed, and compressing a
	# range response would break the browser's pmtiles reader.
	handle_path /tiles/* {
		root * /srv/tiles
		@archive path *.pmtiles
		header @archive Cache-Control "public, max-age=31536000, immutable"
		header /manifest.json Cache-Control "public, max-age=300"
		header /water-warnings.json Cache-Control "public, max-age=300"
		file_server {
			hide .*
		}
	}

	# The app.
	handle {
		root * /srv/www
		encode zstd gzip
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html
		header @shell Cache-Control "public, max-age=300"
		try_files {path} /index.html
		file_server
	}
}
