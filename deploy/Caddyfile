# PawPath web server. TLS is terminated in front (Coolify's proxy, then
# Cloudflare), so this listens on plain :80.
{
	auto_https off
	admin off
}

:80 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
		# Scripts only from this origin: OSM names and other map text can never
		# run as code. Connections and images may go to any https host, so a
		# basemap or search override (VITE_*) keeps working without editing
		# this. MapLibre runs its worker from a blob: URL.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Tiles: shared volume written by the `tiles` container. No `encode` here:
	# the tiles inside a .pmtiles are already compressed, and compressing a
	# range response would break the browser's pmtiles reader.
	handle_path /tiles/* {
		root * /srv/tiles
		@archive path *.pmtiles
		header @archive Cache-Control "public, max-age=31536000, immutable"
		header /manifest.json Cache-Control "public, max-age=300"
		header /water-warnings.json Cache-Control "public, max-age=300"
		file_server {
			hide .*
		}
	}

	# The app.
	handle {
		root * /srv/www
		encode zstd gzip
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html
		header @shell Cache-Control "public, max-age=300"
		try_files {path} /index.html
		file_server
	}
}
